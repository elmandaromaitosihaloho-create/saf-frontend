<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shipping Dashboard</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
  <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar expanded" id="sidebar">
    <div class="sidebar-header">
      <img src="/images/pertamina-aja.png" class="logo">
      <span class="app-title">SAF Integrated Data & Traceability System</span>
    </div>
    <ul>
      <li><a href="/dashboard" class="menu-link"><img src="/images/home.png"><span>Dashboard</span></a></li>
      <li class="active"><a href="/shipping" class="menu-link"><img src="/images/catatan.png"><span>Data Input</span></a></li>
      <li><a href="/traceability" class="menu-link"><img src="/images/blockchain.png"><span>Traceability</span></a></li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="main">
    <div class="topbar">
      <div class="menu-btn" onclick="toggleSidebar()">☰</div>
      <div class="top-right">
        <img src="/images/chat.png">
        <img src="/images/notif.png">
        <img src="/images/admin.png">
      </div>
    </div>

    <div class="content">
      <h1 class="dashboard-title">Shipping Data Input</h1>
      <p class="dashboard-subtitle">Only batches with Ready for Shipping status can proceed</p>

      <div class="card">
        <div class="section-header">
          <h3>Select Loading Batch</h3>
          <p>Batch yang sudah selesai loading dan siap dikirim</p>
        </div>

        <table>
          <thead>
            <tr>
              <th>No.</th>
              <th>Batch ID</th>
              <th>Loading Date & Time</th>
              <th>Vship_in (L)</th>
              <th>Status Shipping</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>

            <% if (batches && batches.length > 0) { %>
              <% batches.forEach(function(batch, index) { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= batch.batch_id %></td>
                  <td><%= batch.loading ? batch.loading.loading_datetime : '-' %></td>
                  <td><%= batch.loading ? batch.loading.Vship_in : '-' %></td>
                  <td>
                    <% if (batch.loading && !batch.shipping) { %>
                      <span class="status ready">Ready for Shipping</span>
                    <% } else if (batch.shipping) { %>
                      <span class="status completed">Shipping Completed</span>
                    <% } else { %>
                      <span class="status progress">Loading Not Completed</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (batch.loading && !batch.shipping) { %>
                      <a href="/shipping-detail?batch_id=<%= batch.batch_id %>" class="btn-action active">
                        Continue <i class="fa-solid fa-arrow-right"></i>
                      </a>
                    <% } else { %>
                      <button class="btn-action disabled" disabled>Continue 🔒</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" style="text-align:center; padding:30px; color:#888;">
                  Belum ada batch tersedia
                </td>
              </tr>
            <% } %>

          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
function toggleSidebar() {
  document.getElementById("sidebar").classList.toggle("collapsed");
}
function toggleProfile() {
  document.getElementById("profileDropdown").style.display =
    document.getElementById("profileDropdown").style.display === "block" ? "none" : "block";
}
function toggleNotif() {
  document.getElementById("notifDropdown").style.display =
    document.getElementById("notifDropdown").style.display === "block" ? "none" : "block";
}
window.onclick = function(e) {
  if (!e.target.closest(".profile-wrapper")) {
    const p = document.getElementById("profileDropdown");
    if (p) p.style.display = "none";
  }
  if (!e.target.closest(".notif-wrapper")) {
    const n = document.getElementById("notifDropdown");
    if (n) n.style.display = "none";
  }
}
</script>
</body>
</html>
