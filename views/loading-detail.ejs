<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loading Detail</title>
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/form.css">
</head>

<body>
<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar expanded" id="sidebar">
    <div class="sidebar-header">
      <img src="/images/pertamina-aja.png" class="logo">
      <span class="app-title">SAF Integrated Data & Traceability System</span>
    </div>
    <ul>
      <li><a href="/dashboard" class="menu-link"><img src="/images/home.png"><span>Dashboard</span></a></li>
      <li class="active"><a href="/loading" class="menu-link"><img src="/images/catatan.png"><span>Data Input</span></a></li>
      <li><a href="/traceability" class="menu-link"><img src="/images/blockchain.png"><span>Traceability</span></a></li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="main">

    <div class="topbar">
      <div class="menu-btn" onclick="toggleSidebar()">☰</div>
      <div class="top-right">
        <img src="/images/chat.png">
        <img src="/images/notif.png">
        <img src="/images/admin.png">
      </div>
    </div>

    <div class="content">

      <h1 class="dashboard-title">Selected Batch</h1>

      <!-- INFO BOX — data dari batch production yang dipilih -->
      <div class="card info-card" style="margin-bottom:24px;">
        <div class="form-grid-3" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px;">

          <div>
            <b>Batch ID:</b><br>
            <%= batchId || '-' %>
          </div>

          <div>
            <b>Feedstock Type:</b><br>
            <%= (batch && batch.feedstock) ? batch.feedstock.type : '-' %>
          </div>

          <div>
            <b>Production Volume / Vi (L):</b><br>
            <%= (batch && batch.production) ? batch.production.Vi : '-' %>
          </div>

          <div>
            <b>Production Date & Time:</b><br>
            <%= (batch && batch.production) ? batch.production.production_datetime : '-' %>
          </div>

          <div>
            <b>Production Pathway:</b><br>
            <%= (batch && batch.production) ? batch.production.pathway : '-' %>
          </div>

          <div>
            <b>Neat SAF / Vn (L):</b><br>
            <%= (batch && batch.production) ? batch.production.Vn : '-' %>
          </div>

        </div>
      </div>

      <!-- STATUS -->
      <% if (status === 'valid') { %>
        <div style="background:#d4edda; color:#155724; padding:12px; border-radius:8px; margin-bottom:16px;">
          ✅ Data berhasil disimpan ke blockchain!
        </div>
        <div class="card" style="margin-bottom:24px; border-left: 4px solid #17338f;">
          <h3 style="margin-bottom:16px; color:#17338f;">📋 Submitted Loading Data</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Batch ID</div>
              <div style="font-weight:600;"><%= batchId %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Loading Date & Time</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? batch.loading.loading_datetime : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Loaded Volume / Vload (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? batch.loading.Vload : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Received Volume / Vship_in (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? batch.loading.Vship_in : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Volume Loss / Lload (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? batch.loading.Lload : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Blended SAF Loss / pi_load (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? Number(batch.loading.pi_load).toFixed(4) : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Neat SAF Loss / pn_load (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? Number(batch.loading.pn_load).toFixed(4) : '-' %></div>
            </div>

            <div>
              <div style="font-size:12px; color:#888; margin-bottom:4px;">Blended SAF Received / Vi_ship_in (L)</div>
              <div style="font-weight:600;"><%= (batch && batch.loading) ? Number(batch.loading.Vi_ship_in).toFixed(2) : '-' %></div>
            </div>

            <div style="grid-column: span 2;">
              <div style="font-size:12px; color:#888; margin-bottom:4px;">SAF Emission (gCO2e)</div>
              <div style="font-weight:600; color:#155724; font-size:16px;">
                <%= (batch && batch.loading) ? Number(batch.loading.SAF_emission).toFixed(4) : '-' %>
              </div>
            </div>

          </div>

          <div style="margin-top:20px;">
            <a href="/loading" style="padding:12px 24px; border-radius:10px; background:#17338f; color:white; text-decoration:none; font-weight:600;">
              ← Back to Loading List
            </a>
          </div>
        </div>

      <% } else if (status === 'invalid') { %>
        <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:8px; margin-bottom:16px;">
          ❌ Failed to save. Check all fields and try again.
        </div>
      <% } %>

      <!-- FORM -->
      <form action="/loading-detail" method="POST">
        <div class="form-card">
          <h3>Loading Data Form</h3>

          <!-- batch_id hidden -->
          <input type="hidden" name="batch_id" value="<%= batchId || '' %>">

          <div class="form-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:20px;">

            <!-- Batch ID readonly untuk konfirmasi -->
            <div>
              <label>Batch ID *</label>
              <input
                type="text"
                value="<%= batchId || '' %>"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px;"
              >
            </div>

            <!-- Vload -->
            <div>
              <label>Loaded Volume (L) *</label>
              <input
                type="number"
                name="Vload"
                id="Vload"
                placeholder="0"
                required
                style="border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px;"
              >
              <small style="color:#888;">Volume loaded into transport</small>
            </div>

            <!-- Vship_in -->
            <div>
              <label>Received Volume (L) *</label>
              <input
                type="number"
                name="Vship_in"
                id="Vship_in"
                placeholder="0"
                required
                style="border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px;"
              >
              <small style="color:#888;">Volume received at next stage</small>
            </div>

            <!-- loading_datetime -->
            <div>
              <label>Loading Date & Time *</label>
              <input
                type="datetime-local"
                name="loading_datetime"
                required
                style="border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px;"
              >
            </div>

            <!-- Volume Loss — otomatis -->
            <div>
              <label>Volume Loss (L)</label>
              <input
                type="text"
                id="vol_loss"
                value="Automated Calculation"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px; color:#777;"
              >
            </div>

            <!-- Blended SAF Loss -->
            <div>
              <label>Blended SAF Loss (L)</label>
              <input
                type="text"
                id="blended_loss"
                value="Automated Calculation"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px; color:#777;"
              >
            </div>

            <!-- Neat SAF Loss -->
            <div>
              <label>Neat SAF Loss (L)</label>
              <input
                type="text"
                id="neat_loss"
                value="Automated Calculation"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px; color:#777;"
              >
            </div>

            <!-- Blended SAF Received Volume -->
            <div>
              <label>Blended SAF Received Volume (L)</label>
              <input
                type="text"
                id="blended_received"
                value="Automated Calculation"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px; color:#777;"
              >
            </div>

            <!-- SAF Emission -->
            <div style="grid-column: span 2;">
              <label>SAF Emission (gCO2e)</label>
              <input
                type="text"
                id="saf_emission"
                value="Automated Calculation"
                readonly
                style="background:#f0f2f8; border:1px solid #d0d5e8; border-radius:10px; padding:12px; width:100%; font-size:14px; color:#777;"
              >
            </div>

          </div>

          <!-- BUTTON -->
          <% if (status !== 'valid') { %>
            <div class="form-actions" style="display:flex; justify-content:flex-end; gap:12px; margin-top:28px;">
              <a href="/loading" style="padding:14px 24px; border-radius:10px; background:#e5e7eb; color:#444; text-decoration:none; font-weight:600;">
                Cancel
              </a>
              <button type="submit" style="padding:14px 24px; border-radius:10px; background:#17338f; color:white; border:none; font-weight:600; cursor:pointer;">
                💾 Save
              </button>
            </div>
          <% } %>

        </div>
      </form>

    </div>
  </div>
</div>

<script>
function toggleSidebar() {
  document.getElementById("sidebar").classList.toggle("collapsed");
}
function toggleProfile() {
  document.getElementById("profileDropdown").style.display =
    document.getElementById("profileDropdown").style.display === "block" ? "none" : "block";
}
function toggleNotif() {
  document.getElementById("notifDropdown").style.display =
    document.getElementById("notifDropdown").style.display === "block" ? "none" : "block";
}
window.onclick = function(e) {
  if (!e.target.closest(".profile-wrapper")) {
    const p = document.getElementById("profileDropdown");
    if (p) p.style.display = "none";
  }
  if (!e.target.closest(".notif-wrapper")) {
    const n = document.getElementById("notifDropdown");
    if (n) n.style.display = "none";
  }
}

// =============================================
// Data dari backend via EJS (dirender server-side)
// =============================================
const Vi_produksi = <%= (batch && batch.production && batch.production.Vi) ? batch.production.Vi : 0 %>;
const Vn_produksi = <%= (batch && batch.production && batch.production.Vn) ? batch.production.Vn : 0 %>;
const HV          = <%= (batch && batch.production && batch.production.HV) ? batch.production.HV : 0 %>;
const pathway     = "<%= (batch && batch.production) ? batch.production.pathway : '' %>";

// Tentukan emission factor berdasarkan pathway
let emissionFactor = 0;
if (pathway === 'HEFA') {
  emissionFactor = 13.9;
} else if (pathway === 'Co-processing') {
  emissionFactor = 16.7;
}

// =============================================
// Fungsi kalkulasi otomatis
// Referensi formula dari server.js backend:
// Lload      = Vload - Vship_in
// pi_load    = Vi x Lload / Vload
// pn_load    = Vn x Lload / Vload
// Vn_ship_in = Vn - pn_load
// SAF_emission = Vn_ship_in x (984.561/1294716) x HV x 1000 x emissionFactor
// =============================================
function hitungOtomatis() {
  const Vload    = parseFloat(document.getElementById('Vload').value)    || 0;
  const Vship_in = parseFloat(document.getElementById('Vship_in').value) || 0;

  if (Vload <= 0 || Vship_in <= 0) {
    reset();
    return;
  }

  const Lload      = Vload - Vship_in;
  const pi_load    = Vi_produksi * Lload / Vload;
  const pn_load    = Vn_produksi * Lload / Vload;
  const Vn_ship_in = Vn_produksi - pn_load;

  // Volume Loss
  document.getElementById('vol_loss').value = Lload.toFixed(2) + ' L';

  // Blended SAF Loss (%)
  const blendedLoss = (Vi_produksi * Lload / Vload);
  document.getElementById('blended_loss').value = blendedLoss.toFixed(4);

  // Neat SAF Loss (%)
  const neatLoss = Vload > 0 ? (Vn_produksi * Lload / Vload) : 0;
  document.getElementById('neat_loss').value = neatLoss.toFixed(4);

  // Blended SAF Received Volume
  const blendLoss = Vi_produksi - pi_load
  document.getElementById('blended_received').value = blendLoss.toFixed(2);

  // SAF Emission
  if (emissionFactor > 0 && HV > 0) {
    const emission = Vn_ship_in * (984.561 / 1294716) * HV * 1000 * emissionFactor;
    document.getElementById('saf_emission').value = emission.toFixed(4);
    document.getElementById('saf_emission').style.color = '#155724';
  } else {
    document.getElementById('saf_emission').value = 'Data produksi tidak lengkap';
    document.getElementById('saf_emission').style.color = '#856404';
  }
}

function reset() {
  document.getElementById('vol_loss').value       = 'Automated Calculation';
  document.getElementById('blended_loss').value   = 'Automated Calculation';
  document.getElementById('neat_loss').value      = 'Automated Calculation';
  document.getElementById('blended_received').value = 'Automated Calculation';
  document.getElementById('saf_emission').value   = 'Automated Calculation';
  document.getElementById('saf_emission').style.color = '#777';
}

document.getElementById('Vload').addEventListener('input', hitungOtomatis);
document.getElementById('Vship_in').addEventListener('input', hitungOtomatis);
</script>

</body>
</html>
