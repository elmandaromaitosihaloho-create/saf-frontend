<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Production Data Input</title>

  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/form.css">

</head>

<body>

<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar expanded" id="sidebar">

    <div class="sidebar-header">
      <img src="/images/pertamina-aja.png" class="logo">

      <span class="app-title">
        SAF Integrated Data &
        Traceability System
      </span>
    </div>

    <ul>

      <!-- DASHBOARD -->
      <li>
        <a href="/dashboard" class="menu-link">
          <img src="/images/home.png">
          <span>Dashboard</span>
        </a>
      </li>

      <!-- DATA INPUT -->
      <li class="active">
        <a href="/production" class="menu-link">
          <img src="/images/catatan.png">
          <span>Data Input</span>
        </a>
      </li>

      <!-- TRACEABILITY -->
      <li>
        <a href="/traceability" class="menu-link">
          <img src="/images/blockchain.png">
          <span>Traceability</span>
        </a>
      </li>

    </ul>

  </div>

  <!-- MAIN -->
  <div class="main">

    <!-- TOPBAR -->
    <div class="topbar">

      <div
        class="menu-btn"
        onclick="toggleSidebar()"
      >
        ☰
      </div>

            <div class="top-right">
        <div style="position:relative;">
          <img src="/images/notif.png" id="notifBtn" style="width:24px;height:24px;cursor:pointer;opacity:0.6;vertical-align:middle;">
          <div id="notifDropdown" style="display:none;position:absolute;right:0;top:36px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.12);min-width:200px;z-index:999;padding:16px;">
            <p style="font-size:13px;color:#888;">Tidak ada notifikasi baru</p>
          </div>
        </div>
        <div style="position:relative;">
          <div id="profileBtn" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <img src="/images/admin.png" style="width:24px;height:24px;opacity:0.6;vertical-align:middle;">
            <span style="font-size:14px;font-weight:600;color:#333;"><%= user || 'User' %></span>
          </div>
          <div id="profileDropdown" style="display:none;position:absolute;right:0;top:36px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.12);min-width:220px;z-index:999;padding:16px;">
            <div style="background:linear-gradient(135deg,#17338f,#3556c9);border-radius:10px;padding:20px;text-align:center;margin-bottom:12px;">
              <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.5);display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                <img src="/images/admin.png" style="width:30px;filter:brightness(0) invert(1);">
              </div>
              <h3 style="color:white;font-size:14px;font-weight:700;margin-bottom:4px;"><%= user || 'User' %></h3>
              <span style="background:rgba(255,255,255,0.2);color:white;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;"><%= role || '-' %></span>
            </div>
            <a href="/profile" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#333;text-decoration:none;font-size:13px;border-radius:8px;">
              <span style="width:28px;height:28px;background:#e8f0fe;border-radius:8px;display:flex;align-items:center;justify-content:center;">👤</span>
              View Profile
            </a>
            <div style="height:1px;background:#f0f0f0;margin:8px 0;"></div>
            <a href="/logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#e53935;text-decoration:none;font-size:13px;border-radius:8px;">
              <span style="width:28px;height:28px;background:#fff0f0;border-radius:8px;display:flex;align-items:center;justify-content:center;">🚪</span>
              Logout
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- CONTENT -->
    <div class="content">

      <h1 class="dashboard-title">
        Add Production Data
      </h1>

      <p class="dashboard-subtitle">
        Enter complete batch information for traceability
      </p>

      <!-- PESAN STATUS -->
      <% if (status === 'valid') { %>
        <div style="background:#d4edda; color:#155724; padding:12px; border-radius:8px; margin-bottom:16px;">
          ✅ Data berhasil disimpan ke blockchain!
        </div>
      <% } else if (status === 'invalid') { %>
        <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:8px; margin-bottom:16px;">
          ❌ Gagal menyimpan data. Pastikan semua field terisi dan coba lagi.
        </div>
      <% } %>

      <!-- FORM CARD -->
      <div class="card">

        <form action="/production" method="POST">

          <!-- SECTION -->
          <div class="form-section">

            <h3>Production Information</h3>

            <div class="form-grid-2">

              <div class="form-group">
                <label>Production Date & Time *</label>
                <input type="datetime-local" name="production_datetime" required>
              </div>

              <div class="form-group">
                <label>Batch ID *</label>
                <input type="text" name="batch_id" placeholder="Example: BATCH001" required>
              </div>

              <div class="form-group">
                <label>Production Location *</label>
                <select name="production_location" required>
                  <option value="">Select Production Location</option>
                  <option value="RU II Dumai">RU II Dumai</option>
                  <option value="RU II Sungai Pakning">RU II Sungai Pakning</option>
                  <option value="RU III Plaju">RU III Plaju</option>
                  <option value="RU IV Cilacap">RU IV Cilacap</option>
                  <option value="RU V Balikpapan">RU V Balikpapan</option>
                  <option value="RU VI Balongan">RU VI Balongan</option>
                  <option value="RU VII Kasim">RU VII Kasim</option>
                </select>
              </div>

              <div class="form-group">
                <label>Production Pathway *</label>
                <select name="pathway" required>
                  <option value="">Select Production Pathway</option>
                  <option value="HEFA-SPK">HEFA-SPK</option>
                  <option value="AtJ-SPK (Isobutanol)">AtJ-SPK (Isobutanol)</option>
                  <option value="AtJ-SPK (Ethanol)">AtJ-SPK (Ethanol)</option>
                  <option value="FT-SPK">FT-SPK</option>
                  <option value="SIP">SIP</option>
                  <option value="Co-processed Oil to be Used for Replacement of Jet Fuel">Co-processed Oil to be Used for Replacement of Jet Fuel</option>
                  <option value="Other">Other</option>
                </select>
              </div>

            </div>

          </div>

          <!-- SECTION -->
          <div class="form-section">

            <h3>Volume & Quality Metrics</h3>

            <div class="form-grid-3">

              <div class="form-group">
                <label>Input Volume (L) *</label>
                <input type="number" name="Vf" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Total Output Volume (L) *</label>
                <input type="number" name="Vi" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Heating Value (MJ/Kg) *</label>
                <input type="number" name="HV" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Conventional Avtur (L) *</label>
                <input type="number" name="Vk" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Neat SAF (L) *</label>
                <input type="number" name="Vn" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>SAF Emission (gCO2e/MJ)</label>
                <input
                  type="text"
                  id="saf_emission"
                  name="saf_emission"
                  value="Automated Calculation"
                  readonly
                >
              </div>

            </div>

          </div>

          <!-- SECTION -->
          <div class="form-section">

            <h3>Feedstock Information</h3>

            <div class="form-grid-2">

              <div class="form-group">
                <label>Feedstock Supplier *</label>
                <input type="text" name="feedstock_supplier" required>
              </div>

              <div class="form-group">
                <label>Feedstock Origin *</label>
                <input type="text" name="feedstock_origin" required>
              </div>

              <div class="form-group">
                <label>Type of Feedstock *</label>
                <select name="type_of_feedstock" required>
                  <option value="">Select Type of Feedstock</option>
                  <option value="Used Cooking Oil">Used Cooking Oil</option>
                  <option value="Palm Oil Mill Effluent">Palm Oil Mill Effluent</option>
                  <option value="Jatropha Oil">Jatropha Oil</option>
                  <option value="Waste Animal Fats">Waste Animal Fats</option>
                  <option value="Algae Biomass">Algae Biomass</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div class="form-group">
                <label>Feedstock Emission *</label>
                <input type="number" name="feedstock_emission" required>
              </div>

              <div class="form-group">
                <label>Feedstock Receiving Date *</label>
                <input type="datetime-local" name="feedstock_receiving_date" required>
              </div>

              <div class="form-group">
                <label>Feedstock Volume *</label>
                <input type="number" name="feedstock_volume" required>
              </div>

            </div>

          </div>

          <!-- BUTTON -->
          <div class="form-actions">

            <button
              type="button"
              class="cancel"
              onclick="window.location.href='/dashboard'"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="save"
            >
              💾 Save
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

</div>

<script>

function toggleSidebar() {
  document
    .getElementById("sidebar")
    .classList.toggle("collapsed");
}

// Hitung SAF Emission otomatis saat Vn atau HV berubah
function hitungSAFEmission() {
  const Vn = parseFloat(document.querySelector('[name="Vn"]').value) || 0;
  const HV = parseFloat(document.querySelector('[name="HV"]').value) || 0;
  const pathway = document.querySelector('[name="pathway"]').value;
  let emissionFactor = 0;
  if (pathway === 'HEFA') {
    emissionFactor = 13.9;
  } else if (pathway === 'Co-processing') {
    emissionFactor = 16.7;
  }
  if (Vn > 0 && HV > 0 && emissionFactor > 0) {
    const emission = Vn * (984.561 / 1294716) * HV * 1000 * emissionFactor;
    document.getElementById('saf_emission').value = emission.toFixed(4) + ' gCO2e';
  } else {
    document.getElementById('saf_emission').value = 'Automated Calculation';
  }
}

document.querySelector('[name="Vn"]').addEventListener('input', hitungSAFEmission);
document.querySelector('[name="HV"]').addEventListener('input', hitungSAFEmission);
document.querySelector('[name="pathway"]').addEventListener('change', hitungSAFEmission);


// Profile & Notif Toggle
const profileBtn = document.getElementById('profileBtn');
const profileDropdown = document.getElementById('profileDropdown');
const notifBtn = document.getElementById('notifBtn');
const notifDropdown = document.getElementById('notifDropdown');

if (profileBtn) {
  profileBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (notifDropdown) notifDropdown.style.display = 'none';
    profileDropdown.style.display = profileDropdown.style.display === 'block' ? 'none' : 'block';
  });
}
if (notifBtn) {
  notifBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (profileDropdown) profileDropdown.style.display = 'none';
    notifDropdown.style.display = notifDropdown.style.display === 'block' ? 'none' : 'block';
  });
}
document.addEventListener('click', function() {
  if (profileDropdown) profileDropdown.style.display = 'none';
  if (notifDropdown) notifDropdown.style.display = 'none';
});
</script>

</body>
</html>
