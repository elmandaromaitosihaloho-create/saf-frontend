<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>Production Data Input</title>

  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/form.css">
<style>
  /* Fix layout grid agar setiap form-group tetap utuh (label + input tidak terpisah) */

  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 24px;
    align-items: start;   /* ← ini kunci: item rata atas, tidak di-stretch */
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px 24px;
    align-items: start;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;             /* ← jarak antara label dan input, bukan antar item */
  }

  .form-group label {
    margin-bottom: 0;     /* hapus margin bawaan jika ada */
    font-weight: 600;
    font-size: 14px;
    color: #1e2b50;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    height: 48px;
    border: 1px solid #d0d5e8;
    border-radius: 10px;
    padding: 0 14px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: #5b73c8;
    box-shadow: 0 0 0 3px rgba(91, 115, 200, 0.15);
  }

  .form-group input[readonly] {
    background: #f0f2f8;
    color: #777;
    cursor: not-allowed;
  }

  .form-section {
    margin-bottom: 32px;
  }

  .form-section h3 {
    font-size: 18px;
    font-weight: 700;
    color: #1e2b50;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom: 2px solid #e8ecf8;
  }
</style>
</head>

<body>

<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar expanded" id="sidebar">

    <div class="sidebar-header">
      <img src="/images/pertamina-aja.png" class="logo">

      <span class="app-title">
        SAF Integrated Data &
        Traceability System
      </span>
    </div>

    <ul>

      <!-- DASHBOARD -->
      <li>
        <a href="/dashboard" class="menu-link">
          <img src="/images/home.png">
          <span>Dashboard</span>
        </a>
      </li>

      <!-- DATA INPUT -->
      <li class="active">
        <a href="/production" class="menu-link">
          <img src="/images/catatan.png">
          <span>Data Input</span>
        </a>
      </li>

      <!-- TRACEABILITY -->
      <li>
        <a href="/traceability" class="menu-link">
          <img src="/images/blockchain.png">
          <span>Traceability</span>
        </a>
      </li>

    </ul>

  </div>

  <!-- MAIN -->
  <div class="main">

    <!-- TOPBAR -->
    <div class="topbar">

      <div
        class="menu-btn"
        onclick="toggleSidebar()"
      >
        ☰
      </div>

      <div class="top-right">

        <img src="/images/notif.png">

        <img src="/images/admin.png">

      </div>

    </div>

    <!-- CONTENT -->
    <div class="content">

      <h1 class="dashboard-title">
        Add Production Data
      </h1>

      <p class="dashboard-subtitle">
        Enter complete batch information for traceability
      </p>

      <!-- PESAN STATUS -->
      <% if (status === 'valid') { %>
        <div style="background:#d4edda; color:#155724; padding:12px; border-radius:8px; margin-bottom:16px;">
          ✅ Data berhasil disimpan ke blockchain!
        </div>
      <% } else if (status === 'invalid') { %>
        <div style="background:#f8d7da; color:#721c24; padding:12px; border-radius:8px; margin-bottom:16px;">
          ❌ Gagal menyimpan data. Pastikan semua field terisi dan coba lagi.
        </div>
      <% } %>

      <!-- FORM CARD -->
      <div class="card">

        <form action="/production" method="POST">

          <!-- SECTION -->
          <div class="form-section">

            <h3>Production Information</h3>

            <div class="form-grid-2">

              <div class="form-group">
                <label>Production Date & Time *</label>
                <input type="datetime-local" name="production_datetime" required>
              </div>

              <div class="form-group">
                <label>Batch ID *</label>
                <input type="text" name="batch_id" placeholder="Example: BATCH001" required>
              </div>

              <div class="form-group">
                <label>Production Location *</label>
                <select name="production_location" required>
                  <option value="">Select Production Location</option>
                  <option value="RU II Dumai">RU II Dumai</option>
                  <option value="RU III Plaju">RU III Plaju</option>
                  <option value="RU IV Cilacap">RU IV Cilacap</option>
                </select>
              </div>

              <div class="form-group">
                <label>Production Pathway *</label>
                <select name="pathway" required>
                  <option value="">Select Production Pathway</option>
                  <option value="HEFA">HEFA</option>
                  <option value="Co-processing">Co-processing</option>
                </select>
              </div>

            </div>

          </div>

          <!-- SECTION -->
          <div class="form-section">

            <h3>Volume & Quality Metrics</h3>

            <div class="form-grid-3">

              <div class="form-group">
                <label>Input Volume (L) *</label>
                <input type="number" name="Vf" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Total Output Volume (L) *</label>
                <input type="number" name="Vi" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Heating Value (MJ/Kg) *</label>
                <input type="number" name="HV" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Conventional Avtur (L) *</label>
                <input type="number" name="Vk" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>Neat SAF (L) *</label>
                <input type="number" name="Vn" placeholder="0" required>
              </div>

              <div class="form-group">
                <label>SAF Emission (gCO2e/MJ)</label>
                <input
                  type="text"
                  id="saf_emission"
                  name="saf_emission"
                  value="Automated Calculation"
                  readonly
                >
              </div>

            </div>

          </div>

          <!-- SECTION -->
          <div class="form-section">

            <h3>Feedstock Information</h3>

            <div class="form-grid-2">

              <div class="form-group">
                <label>Feedstock Supplier *</label>
                <input type="text" name="feedstock_supplier" required>
              </div>

              <div class="form-group">
                <label>Feedstock Origin *</label>
                <input type="text" name="feedstock_origin" required>
              </div>

              <div class="form-group">
                <label>Type of Feedstock *</label>
                <select name="type_of_feedstock" required>
                  <option value="">Select Type of Feedstock</option>
                  <option value="Used Cooking Oil">Used Cooking Oil</option>
                  <option value="Palm Oil Mill Effluent">Palm Oil Mill Effluent</option>
                  <option value="Waste Animal Fat">Waste Animal Fat</option>
                </select>
              </div>

              <div class="form-group">
                <label>Feedstock Emission *</label>
                <input type="number" name="feedstock_emission" required>
              </div>

              <div class="form-group">
                <label>Feedstock Receiving Date *</label>
                <input type="datetime-local" name="feedstock_receiving_date" required>
              </div>

              <div class="form-group">
                <label>Feedstock Volume *</label>
                <input type="number" name="feedstock_volume" required>
              </div>

            </div>

          </div>

          <!-- BUTTON -->
          <div class="form-actions">

            <button
              type="button"
              class="cancel"
              onclick="window.location.href='/dashboard'"
            >
              Cancel
            </button>

            <button
              type="submit"
              class="save"
            >
              💾 Save
            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

</div>

<script>

function toggleSidebar() {
  document
    .getElementById("sidebar")
    .classList
    .toggle("expanded");
}

// Hitung SAF Emission otomatis saat Vn atau HV berubah
function hitungSAFEmission() {
  const Vn = parseFloat(document.querySelector('[name="Vn"]').value) || 0;
  const HV = parseFloat(document.querySelector('[name="HV"]').value) || 0;
  const pathway = document.querySelector('[name="pathway"]').value;
  let emissionFactor = 0;
  if (pathway === 'HEFA') {
    emissionFactor = 13.9;
  } else if (pathway === 'Co-processing') {
    emissionFactor = 16.7;
  }
  if (Vn > 0 && HV > 0 && emissionFactor > 0) {
    const emission = Vn * (984.561 / 1294716) * HV * 1000 * emissionFactor;
    document.getElementById('saf_emission').value = emission.toFixed(4) + ' gCO2e';
  } else {
    document.getElementById('saf_emission').value = 'Automated Calculation';
  }
}

document.querySelector('[name="Vn"]').addEventListener('input', hitungSAFEmission);
document.querySelector('[name="HV"]').addEventListener('input', hitungSAFEmission);
document.querySelector('[name="pathway"]').addEventListener('change', hitungSAFEmission);

</script>

</body>
</html>
