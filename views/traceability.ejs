<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Traceability Dashboard</title>
  <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
<div class="container">

  <!-- SIDEBAR -->
  <div class="sidebar expanded" id="sidebar">
    <div class="sidebar-header">
      <img src="/images/pertamina-aja.png" class="logo">
      <span class="app-title">SAF Integrated Data & Traceability System</span>
    </div>
    <ul>
      <li><a href="/dashboard" class="menu-link"><img src="/images/home.png"><span>Dashboard</span></a></li>
      <li>
        <% if (role === "Production") { %><a href="/production" class="menu-link">
        <% } else if (role === "Loading") { %><a href="/loading" class="menu-link">
        <% } else if (role === "Shipping") { %><a href="/shipping" class="menu-link">
        <% } else if (role === "Terminal") { %><a href="/terminal" class="menu-link">
        <% } else { %><a href="/fueling" class="menu-link">
        <% } %>
          <img src="/images/catatan.png"><span>Data Input</span>
        </a>
      </li>
      <li class="active"><a href="/traceability" class="menu-link"><img src="/images/blockchain.png"><span>Traceability</span></a></li>
    </ul>
  </div>

  <!-- MAIN -->
  <div class="main">
    <div class="topbar">
      <div class="menu-btn" onclick="toggleSidebar()">☰</div>
      <div class="top-right">
        <div style="position:relative;">
          <img src="/images/notif.png" id="notifBtn" style="width:24px;height:24px;cursor:pointer;opacity:0.6;vertical-align:middle;">
          <div id="notifDropdown" style="display:none;position:absolute;right:0;top:36px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.12);min-width:200px;z-index:999;padding:16px;">
            <p style="font-size:13px;color:#888;">Tidak ada notifikasi baru</p>
          </div>
        </div>
        <div style="position:relative;">
          <div id="profileBtn" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <img src="/images/admin.png" style="width:24px;height:24px;opacity:0.6;vertical-align:middle;">
            <span style="font-size:14px;font-weight:600;color:#333;"><%= user || 'User' %></span>
          </div>
          <div id="profileDropdown" style="display:none;position:absolute;right:0;top:36px;background:white;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,0.12);min-width:220px;z-index:999;padding:16px;">
            <div style="background:linear-gradient(135deg,#17338f,#3556c9);border-radius:10px;padding:20px;text-align:center;margin-bottom:12px;">
              <div style="width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,0.2);border:2px solid rgba(255,255,255,0.5);display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                <img src="/images/admin.png" style="width:30px;filter:brightness(0) invert(1);">
              </div>
              <h3 style="color:white;font-size:14px;font-weight:700;margin-bottom:4px;"><%= user || 'User' %></h3>
              <span style="background:rgba(255,255,255,0.2);color:white;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:600;"><%= role || '-' %></span>
            </div>
            <a href="/profile" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#333;text-decoration:none;font-size:13px;border-radius:8px;">
              <span style="width:28px;height:28px;background:#e8f0fe;border-radius:8px;display:flex;align-items:center;justify-content:center;">👤</span>
              View Profile
            </a>
            <div style="height:1px;background:#f0f0f0;margin:8px 0;"></div>
            <a href="/logout" style="display:flex;align-items:center;gap:10px;padding:10px 12px;color:#e53935;text-decoration:none;font-size:13px;border-radius:8px;">
              <span style="width:28px;height:28px;background:#fff0f0;border-radius:8px;display:flex;align-items:center;justify-content:center;">🚪</span>
              Logout
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="content">

      <!-- SEARCH -->
      <div class="card filter-card">
        <h2 class="section-title">⌕ Search Blockchain Record</h2>
        <form action="/traceability" method="GET">
          <div class="filter-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:16px;">
            <div class="filter-group">
              <label>Blockchain TX ID</label>
              <input
                type="text"
                name="tx_id"
                placeholder="Masukkan Blockchain TX ID"
                value="<%= typeof txId !== 'undefined' ? txId : '' %>"
                style="width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; font-size:14px;"
              >
            </div>
            <div style="display:flex; align-items:flex-end;">
              <button type="submit" style="padding:12px 24px; background:#17338f; color:white; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                🔍 Search
              </button>
            </div>
          </div>
        </form>
      </div>

      <!-- TABLE -->
      <div class="card">
        <h2 class="table-title">Blockchain Record</h2>

        <div class="table-wrapper">
          <table class="trace-table">
            <thead>
              <tr>
                <th>Date & Time</th>
                <th>Blockchain TX ID</th>
                <th>Batch ID (Sumber)</th>
                <th>Recipient</th>
                <th>SAF Volume (L)</th>
                <th>Tank ID</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>

              <% if (fuelings && fuelings.length > 0) { %>
                <% fuelings.forEach(function(f) { %>
                  <tr>
                    <td><%= f.datetime ? new Date(f.datetime).toLocaleString('id-ID') : '-' %></td>
                    <td style="font-family:monospace; font-size:12px;">
                      <%= f.blockchain_tx_id ? f.blockchain_tx_id.substring(0,16) + '...' : '-' %>
                    </td>
                    <td>
                      <% if (f.batch_sources && f.batch_sources.length > 0) { %>
                        <%= f.batch_sources.map(function(b){ return b.batch_id; }).join(', ') %>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td><%= f.recipient ? f.recipient.name : '-' %></td>
                    <td><%= f.Vfuel ? f.Vfuel.toLocaleString() : '-' %></td>
                    <td><%= f.tank_id || '-' %></td>
                    <td>
                      <% if (f.blockchain_tx_id) { %>
                        <a href="/traceability-detail/<%= f.blockchain_tx_id %>" class="eye-btn">👁</a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align:center; padding:30px; color:#888;">
                    Belum ada data blockchain
                  </td>
                </tr>
              <% } %>

            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
function toggleSidebar() {
  document.getElementById("sidebar").classList.toggle("collapsed");
}
function toggleProfile() {
  document.getElementById("profileDropdown").style.display =
    document.getElementById("profileDropdown").style.display === "block" ? "none" : "block";
}
function toggleNotif() {
  document.getElementById("notifDropdown").style.display =
    document.getElementById("notifDropdown").style.display === "block" ? "none" : "block";
}
window.onclick = function(e) {
  if (!e.target.closest(".profile-wrapper")) {
    const p = document.getElementById("profileDropdown");
    if (p) p.style.display = "none";
  }
  if (!e.target.closest(".notif-wrapper")) {
    const n = document.getElementById("notifDropdown");
    if (n) n.style.display = "none";
  }
}

const profileBtn = document.getElementById('profileBtn');
const profileDropdown = document.getElementById('profileDropdown');
const notifBtn = document.getElementById('notifBtn');
const notifDropdown = document.getElementById('notifDropdown');
if (profileBtn) {
  profileBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (notifDropdown) notifDropdown.style.display = 'none';
    profileDropdown.style.display = profileDropdown.style.display === 'block' ? 'none' : 'block';
  });
}
if (notifBtn) {
  notifBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (profileDropdown) profileDropdown.style.display = 'none';
    notifDropdown.style.display = notifDropdown.style.display === 'block' ? 'none' : 'block';
  });
}
document.addEventListener('click', function() {
  if (profileDropdown) profileDropdown.style.display = 'none';
  if (notifDropdown) notifDropdown.style.display = 'none';
});
</script>
</body>
</html>
